[Unit]
Description=Ламповый календарь (Яндекс Календарь на маленьком мониторе)
After=network-online.target
Wants=network-online.target

[Service]
User=__USER__
WorkingDirectory=__DIR__
Environment=YACAL_DATA=__DIR__/data
# Закрыть регистрацию после создания своего аккаунта: Environment=YACAL_ALLOW_REGISTRATION=0
ExecStart=__DIR__/.venv/bin/uvicorn app.main:app --host 0.0.0.0 --port 8080
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
